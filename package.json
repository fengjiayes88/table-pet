{
  "name": "qixi-pet",
  "version": "1.0.0",
  "description": "桌面宠物七七 - 陪伴你办公的猫咪伙伴",
  "main": "src/main.js",
  "author": "七七的主人",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "build:dir": "electron-builder --win --dir"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^28.0.0"
  },
  "build": {
    "appId": "com.qixi.pet",
    "productName": "七七桌面宠物",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "unicode": true
    }
  }
}
